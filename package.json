  },
  "engines": {
    "node": ">=22.18"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261113.1",
    "@types/node": "^22.10.0",
    "typescript": "^5.6.3",
    "wrangler": "^4.40.0"
  }
}
